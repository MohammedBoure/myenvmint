#!/usr/bin/env bash
# ==============================================================================
# agys - Multi-Instance Antigravity CLI (agy) Orchestrator & Manager
# Manages independent ~/.gemini configuration environments for agy instances (agy1, agy2, ...).
# ==============================================================================

set -e

INSTANCES_BASE_DIR="${AGY_INSTANCES_DIR:-$HOME/.local/share/agy-instances}"
GLOBAL_GEMINI_DIR="$HOME/.gemini"

show_help() {
    cat << 'EOF_HELP'
agys - Antigravity Multi-Instance CLI Manager

Usage:
  agys -l | --list             List all existing agy instances and their statuses
  agys -u | --usage | -usage   Show collective quota and usage limits table for all accounts
  agys -r | --run <N> [args..] Run instance agy<N> with optional arguments
  agys -d | --delete <N>       Delete an instance and its isolated environment
  agys -h | --help             Show this help message

Dynamic Command Syntax:
  agy1, agy2, agy3, ... agyN   Directly invokes instance N (created automatically on first use)
EOF_HELP
}

# Ensure bubblewrap is available for namespace filesystem isolation
check_prerequisites() {
    if ! command -v bwrap >/dev/null 2>&1; then
        echo "Error: 'bwrap' (bubblewrap) is required for instance isolation." >&2
        echo "Please install it using: sudo apt-get install -y bubblewrap" >&2
        exit 1
    fi
    if ! command -v agy >/dev/null 2>&1 && [ ! -x "$HOME/.local/bin/agy" ]; then
        echo "Error: 'agy' binary not found in PATH or ~/.local/bin/agy." >&2
        exit 1
    fi
}

# Ensure an instance environment exists, initialized with global instructions & settings
ensure_instance() {
    local inst_id="$1"
    local inst_dir="$INSTANCES_BASE_DIR/agy${inst_id}"
    local inst_gemini_dir="$inst_dir/.gemini"

    if [ ! -d "$inst_gemini_dir" ]; then
        mkdir -p "$inst_gemini_dir/config/rules"
        mkdir -p "$inst_gemini_dir/config/projects"
        mkdir -p "$inst_gemini_dir/antigravity-cli/cache"

        # Seed global instructions & configurations if available
        if [ -d "$GLOBAL_GEMINI_DIR/config" ]; then
            cp -r "$GLOBAL_GEMINI_DIR/config/"* "$inst_gemini_dir/config/" 2>/dev/null || true
        fi

        # Seed GEMINI.md / AGENTS.md if present
        for f in GEMINI.md AGENTS.md; do
            if [ -f "$GLOBAL_GEMINI_DIR/$f" ]; then
                cp "$GLOBAL_GEMINI_DIR/$f" "$inst_gemini_dir/$f" 2>/dev/null || true
            fi
        done

        # Seed settings.json (editor, theme, permissions) WITHOUT copying any tokens
        if [ -f "$GLOBAL_GEMINI_DIR/antigravity-cli/settings.json" ]; then
            cp "$GLOBAL_GEMINI_DIR/antigravity-cli/settings.json" "$inst_gemini_dir/antigravity-cli/settings.json" 2>/dev/null || true
        else
            cat << 'SETTINGS_EOF' > "$inst_gemini_dir/antigravity-cli/settings.json"
{
  "agentMode": "accept-edits",
  "artifactReviewPolicy": "always-proceed",
  "colorScheme": "tokyo night",
  "toolPermission": "always-proceed"
}
SETTINGS_EOF
        fi

        # Pre-seed onboarding completion state to bypass interactive terms/onboarding prompts
        cat << 'ONBOARD_EOF' > "$inst_gemini_dir/antigravity-cli/cache/onboarding.json"
{
  "consumerOnboardingComplete": true,
  "enterpriseOnboardingComplete": false,
  "onboardingComplete": true
}
ONBOARD_EOF

        # Explicitly ensure NO token file is copied so each instance is strictly logged out initially
        rm -f "$inst_gemini_dir/antigravity-cli/antigravity-oauth-token"
    fi
}

run_instance() {
    local inst_id="$1"
    shift
    local inst_gemini_dir="$INSTANCES_BASE_DIR/agy${inst_id}/.gemini"

    check_prerequisites
    ensure_instance "$inst_id"

    # Isolate system keyring and D-Bus session bus completely.
    # By masking /run/user with a tmpfs and unsetting DBUS_SESSION_BUS_ADDRESS,
    # agy cannot access the shared desktop keyring service, forcing it to save
    # and restore authentication tokens strictly within each instance's ~/.gemini folder.
    exec env -u DBUS_SESSION_BUS_ADDRESS bwrap \
        --dev-bind / / \
        --tmpfs /run/user \
        --bind "$inst_gemini_dir" "$HOME/.gemini" \
        agy "$@"
}

list_instances() {
    echo "=========================================================================================="
    echo "                              AGY Multi-Instance Registry                                 "
    echo "=========================================================================================="
    printf "%-10s | %-12s | %-28s | %-8s | %s\n" "INSTANCE" "AUTH STATUS" "ACCOUNT / EMAIL" "STORAGE" "LOCATION"
    echo "------------------------------------------------------------------------------------------"

    if [ ! -d "$INSTANCES_BASE_DIR" ] || [ -z "$(ls -A "$INSTANCES_BASE_DIR" 2>/dev/null)" ]; then
        echo "No agy instances found. Run 'agy1', 'agy2', etc. to create one."
        echo "=========================================================================================="
        return 0
    fi

    local ids
    ids=$(find "$INSTANCES_BASE_DIR" -mindepth 1 -maxdepth 1 -type d -name "agy[0-9]*" 2>/dev/null | sed 's/.*\/agy//' | sort -n)

    if [ -z "$ids" ]; then
        echo "No agy instances found. Run 'agy1', 'agy2', etc. to create one."
        echo "=========================================================================================="
        return 0
    fi

    for id in $ids; do
        local dir="$INSTANCES_BASE_DIR/agy${id}"
        local name="agy${id}"
        local gemini_dir="$dir/.gemini"
        local auth_status="Logged Out"
        local email="-"

        local token_file="$gemini_dir/antigravity-cli/antigravity-oauth-token"
        if [ -f "$token_file" ]; then
            auth_status="Logged In"
            email=$(python3 -c "
import json, base64, sys
try:
    with open('$token_file') as f:
        d = json.load(f)
    token = d.get('id_token', '')
    if token:
        parts = token.split('.')
        payload = parts[1] + '=' * (-len(parts[1]) % 4)
        info = json.loads(base64.urlsafe_b64decode(payload))
        print(info.get('email', '-'))
    else:
        print('-')
except Exception:
    print('-')
" 2>/dev/null || echo "-")
        elif [ -f "$gemini_dir/antigravity-cli/settings.json" ]; then
            auth_status="Configured"
        fi

        local disk_size
        disk_size=$(du -sh "$dir" 2>/dev/null | cut -f1)
        printf "%-10s | %-12s | %-28s | %-8s | %s\n" "$name" "$auth_status" "$email" "$disk_size" "$dir"
    done
    echo "=========================================================================================="
}

show_usage() {
    python3 - "$INSTANCES_BASE_DIR" << 'PY_EOF'
import os, sys, json, base64, urllib.request, urllib.parse, concurrent.futures, re, time, pty, select, subprocess
from datetime import datetime, timezone

base_dir = sys.argv[1]

def get_oauth_creds():
    import shutil
    agy_bin = shutil.which('agy') or os.path.expanduser('~/.local/bin/agy')
    try:
        with open(agy_bin, 'rb') as f:
            content = f.read()
        cid = [i.decode() for i in re.findall(rb'[0-9]+-[a-z0-9_]+\.apps\.googleusercontent\.com', content) if b'1071006060591' in i][0]
        csec = [s.decode() for s in re.findall(rb'GOCSPX-[A-Za-z0-9_-]{28}', content) if b'LdLJ1' in s][0]
        return cid, csec
    except Exception:
        return None, None

CLIENT_ID, CLIENT_SECRET = get_oauth_creds()

def format_countdown(iso_str):
    if not iso_str:
        return ''
    try:
        t = datetime.fromisoformat(iso_str.replace('Z', '+00:00'))
        now = datetime.now(timezone.utc)
        diff = t - now
        total_sec = int(diff.total_seconds())
        if total_sec <= 0:
            return 'Now'
        hours, rem = divmod(total_sec, 3600)
        minutes = rem // 60
        if hours > 24:
            days = hours // 24
            return f'{days}d {hours%24}h'
        elif hours > 0:
            return f'{hours}h {minutes}m'
        else:
            return f'{minutes}m'
    except Exception:
        return ''

def visible_len(s):
    return len(re.sub(r'\x1B(?:[@-Z\\-_]|\[[0-?]*[ -/]*[@-~])', '', s))

def pad_str(s, width, align='left'):
    vlen = visible_len(s)
    pad = max(0, width - vlen)
    if align == 'right':
        return ' ' * pad + s
    elif align == 'center':
        left = pad // 2
        right = pad - left
        return ' ' * left + s + ' ' * right
    return s + ' ' * pad

def make_quota_cell(fraction, reset_str, width=10):
    if fraction is None:
        return '\033[90m[' + '─' * width + ']      -       \033[0m'
    pct = max(0.0, min(1.0, float(fraction))) * 100
    filled = int(round(width * (pct / 100.0)))
    empty = width - filled
    
    if pct >= 50:
        color = '\033[38;5;82m'   # bright green
    elif pct >= 20:
        color = '\033[38;5;214m'  # warm yellow/amber
    else:
        color = '\033[38;5;196m'  # red
    
    bar_str = '█' * filled + '░' * empty
    base = f'{color}[{bar_str}] {pct:5.1f}%\033[0m'
    if reset_str:
        base += f' \033[90m({reset_str})\033[0m'
    return base

def scrape_headless_tui(inst_gemini_dir):
    try:
        master, slave = pty.openpty()
        env = dict(os.environ)
        env.pop('DBUS_SESSION_BUS_ADDRESS', None)
        env['TERM'] = 'xterm-256color'

        cmd = [
            'bwrap',
            '--dev-bind', '/', '/',
            '--tmpfs', '/run/user',
            '--bind', inst_gemini_dir, os.path.expanduser('~/.gemini'),
            'agy'
        ]

        t0 = time.time()
        p = subprocess.Popen(cmd, stdin=slave, stdout=slave, stderr=slave, close_fds=True, env=env)
        os.close(slave)

        startup_buf = b''
        for _ in range(40):
            time.sleep(0.12)
            while select.select([master], [], [], 0.05)[0]:
                startup_buf += os.read(master, 4096)
            if b'Flash' in startup_buf or b'shortcuts' in startup_buf or b'>' in startup_buf:
                break

        # Dismiss any welcome tips, verbosity modals or toasts
        os.write(master, b'\x1b')
        time.sleep(0.15)
        os.write(master, b'\x1b')
        time.sleep(0.15)

        # Clear incoming buffer completely
        while select.select([master], [], [], 0.05)[0]:
            os.read(master, 4096)

        # Trigger internal usage screen
        os.write(master, b'/usage\r')

        buf = b''
        for _ in range(40):
            time.sleep(0.12)
            while select.select([master], [], [], 0.05)[0]:
                buf += os.read(master, 4096)
            if b'Weekly Limit Remaining' in buf:
                break

        p.terminate()
        try:
            p.wait(timeout=1)
        except Exception:
            p.kill()
        os.close(master)

        clean = re.sub(r'\x1b\[[0-9;?]*[a-zA-Z]', '', buf.decode('utf-8', errors='ignore'))
        w_match = re.search(r'Weekly Limit Remaining\s*\[[█░]+\]\s*([0-9.]+)%\s*(?:Refreshes in\s*([0-9a-z ]+))?', clean)
        fh_match = re.search(r'Five Hour Limit Remaining\s*\[[█░]+\]\s*([0-9.]+)%\s*(?:Refreshes in\s*([0-9a-z ]+))?', clean)

        if w_match:
            w_frac = float(w_match.group(1)) / 100.0
            w_reset = (w_match.group(2) or '').strip()
            fh_frac = float(fh_match.group(1)) / 100.0 if fh_match else None
            fh_reset = (fh_match.group(2) or '').strip() if fh_match else ''
            return w_frac, w_reset, fh_frac, fh_reset
    except Exception:
        pass
    return None

def fetch_inst(inst_path):
    inst_name = os.path.basename(inst_path)
    inst_gemini_dir = os.path.join(inst_path, '.gemini')
    token_file = os.path.join(inst_gemini_dir, 'antigravity-cli/antigravity-oauth-token')
    
    if not os.path.isfile(token_file):
        return {
            'instance': inst_name,
            'email': '-',
            'status': '\033[90mLogged Out\033[0m',
            'five_hour_cell': make_quota_cell(None, ''),
            'weekly_cell': make_quota_cell(None, ''),
            'is_active': False
        }
    
    email = '-'
    try:
        with open(token_file) as f:
            token_data = json.load(f)
        
        id_token = token_data.get('id_token', '')
        if id_token:
            parts = id_token.split('.')
            payload = parts[1] + '=' * (-len(parts[1]) % 4)
            info = json.loads(base64.urlsafe_b64decode(payload))
            email = info.get('email', '-')
    except Exception:
        pass

    # Authoritative extraction directly from Antigravity engine via headless virtual terminal
    tui_res = scrape_headless_tui(inst_gemini_dir)
    if tui_res:
        weekly_frac, weekly_reset, five_hour_frac, five_hour_reset = tui_res
        status_colored = '\033[32mActive\033[0m'
        if (five_hour_frac is not None and five_hour_frac < 0.1) or (weekly_frac is not None and weekly_frac < 0.1):
            status_colored = '\033[31mExhausted\033[0m'
        elif (five_hour_frac is not None and five_hour_frac < 0.3) or (weekly_frac is not None and weekly_frac < 0.3):
            status_colored = '\033[33mLow Quota\033[0m'
            
        return {
            'instance': inst_name,
            'email': email,
            'status': status_colored,
            'five_hour_cell': make_quota_cell(five_hour_frac, five_hour_reset),
            'weekly_cell': make_quota_cell(weekly_frac, weekly_reset),
            'is_active': True
        }

    # Fallback to cloudcode API endpoints if virtual terminal capture is unavailable
    try:
        token_obj = token_data.get('token', {})
        access_token = token_obj.get('access_token')
        refresh_token = token_obj.get('refresh_token')
        
        def call_api(endpoint, atk):
            url = f'https://daily-cloudcode-pa.googleapis.com/v1internal:{endpoint}'
            req = urllib.request.Request(
                url,
                headers={'Authorization': f'Bearer {atk}', 'Content-Type': 'application/json', 'User-Agent': 'Antigravity/1.4.4'},
                data=b'{}'
            )
            with urllib.request.urlopen(req, timeout=5) as resp:
                return json.loads(resp.read().decode())
        
        q_summary = None
        models_res = None
        try:
            q_summary = call_api('retrieveUserQuotaSummary', access_token)
            models_res = call_api('fetchAvailableModels', access_token)
        except Exception:
            if refresh_token and CLIENT_ID and CLIENT_SECRET:
                r_req = urllib.request.Request(
                    'https://oauth2.googleapis.com/token',
                    data=urllib.parse.urlencode({
                        'client_id': CLIENT_ID,
                        'client_secret': CLIENT_SECRET,
                        'refresh_token': refresh_token,
                        'grant_type': 'refresh_token'
                    }).encode('utf-8'),
                    headers={'Content-Type': 'application/x-www-form-urlencoded'}
                )
                with urllib.request.urlopen(r_req, timeout=5) as r_resp:
                    new_tok = json.loads(r_resp.read().decode())
                access_token = new_tok['access_token']
                token_obj['access_token'] = access_token
                token_data['token'] = token_obj
                with open(token_file, 'w') as f:
                    json.dump(token_data, f, indent=2)
                q_summary = call_api('retrieveUserQuotaSummary', access_token)
                models_res = call_api('fetchAvailableModels', access_token)
            else:
                return {
                    'instance': inst_name,
                    'email': email,
                    'status': '\033[33mAuth Expired\033[0m',
                    'five_hour_cell': make_quota_cell(None, ''),
                    'weekly_cell': make_quota_cell(None, ''),
                    'is_active': False
                }
        
        weekly_frac = 1.0
        weekly_reset = ''
        if q_summary:
            found_gemini = False
            for g in q_summary.get('groups', []):
                if 'gemini' in g.get('displayName', '').lower():
                    for b in g.get('buckets', []):
                        if b.get('window') == 'weekly':
                            weekly_frac = b.get('remainingFraction', 1.0)
                            weekly_reset = format_countdown(b.get('resetTime'))
                            found_gemini = True
                            break
            if not found_gemini:
                for g in q_summary.get('groups', []):
                    for b in g.get('buckets', []):
                        if b.get('window') == 'weekly':
                            f = b.get('remainingFraction', 1.0)
                            if f < weekly_frac:
                                weekly_frac = f
                                weekly_reset = format_countdown(b.get('resetTime'))
                            elif not weekly_reset and b.get('resetTime'):
                                weekly_reset = format_countdown(b.get('resetTime'))
        
        five_hour_frac = 1.0
        five_hour_reset = ''
        if models_res:
            models_dict = models_res.get('models', {})
            target_keys = ['gemini-3.8-flash-tiered', 'gemini-3-flash-agent', 'gemini-3.5-flash-lite', 'gemini-3-flash', 'gemini-2.5-flash', 'gemini-2.5-pro']
            chosen_key = None
            for tk in target_keys:
                if tk in models_dict and 'quotaInfo' in models_dict[tk]:
                    chosen_key = tk
                    break
            if not chosen_key:
                for mk, mv in models_dict.items():
                    if mk.startswith('gemini-') and ('flash' in mk or 'pro' in mk) and 'quotaInfo' in mv:
                        chosen_key = mk
                        break
            if chosen_key:
                qinfo = models_dict[chosen_key]['quotaInfo']
                if 'remainingFraction' in qinfo:
                    five_hour_frac = qinfo['remainingFraction']
                    five_hour_reset = format_countdown(qinfo.get('resetTime'))
        
        status_colored = '\033[32mActive\033[0m'
        if (five_hour_frac is not None and five_hour_frac < 0.1) or (weekly_frac is not None and weekly_frac < 0.1):
            status_colored = '\033[31mExhausted\033[0m'
        elif (five_hour_frac is not None and five_hour_frac < 0.3) or (weekly_frac is not None and weekly_frac < 0.3):
            status_colored = '\033[33mLow Quota\033[0m'
            
        return {
            'instance': inst_name,
            'email': email,
            'status': status_colored,
            'five_hour_cell': make_quota_cell(five_hour_frac, five_hour_reset),
            'weekly_cell': make_quota_cell(weekly_frac, weekly_reset),
            'is_active': True
        }
    except Exception:
        return {
            'instance': inst_name,
            'email': email if 'email' in locals() else '-',
            'status': '\033[31mOffline\033[0m',
            'five_hour_cell': make_quota_cell(None, ''),
            'weekly_cell': make_quota_cell(None, ''),
            'is_active': False
        }

if not os.path.isdir(base_dir):
    print("No agy instances found. Run 'agy1', 'agy2', etc. to create one.")
    sys.exit(0)

dirs = sorted([os.path.join(base_dir, d) for d in os.listdir(base_dir) if re.match(r'^agy[0-9]+$', d)],
              key=lambda p: int(re.search(r'\d+', os.path.basename(p)).group()))

if not dirs:
    print("No agy instances found. Run 'agy1', 'agy2', etc. to create one.")
    sys.exit(0)

with concurrent.futures.ThreadPoolExecutor(max_workers=8) as ex:
    rows = list(ex.map(fetch_inst, dirs))

headers = ['INSTANCE', 'ACCOUNT / EMAIL', 'STATUS', '5-HOUR LIMIT (BAR)', 'WEEKLY LIMIT (BAR)']
widths = [10, 28, 12, 32, 32]

total_w = sum(widths) + (len(widths) - 1) * 3
sep_line = '=' * total_w
div_line = '-' * total_w

print(sep_line)
print(pad_str('AGY Multi-Instance Collective Quota & Usage', total_w, 'center'))
print(sep_line)
print(' | '.join(pad_str(h, w) for h, w in zip(headers, widths)))
print(div_line)

for r in rows:
    vals = [
        r['instance'],
        r['email'],
        r['status'],
        r['five_hour_cell'],
        r['weekly_cell']
    ]
    print(' | '.join(pad_str(v, w) for v, w in zip(vals, widths)))

print(sep_line)
active_count = sum(1 for r in rows if r['is_active'])
print(f'Total Instances: {len(rows)}  |  Active Accounts: {active_count}  |  Logged Out: {len(rows) - active_count}')
print(sep_line)
PY_EOF
}

delete_instance() {
    local inst_id="$1"
    local inst_dir="$INSTANCES_BASE_DIR/agy${inst_id}"
    if [ ! -d "$inst_dir" ]; then
        echo "Instance agy${inst_id} does not exist."
        return 1
    fi
    printf "Are you sure you want to delete agy%s (%s)? [y/N]: " "$inst_id" "$inst_dir"
    read -r confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        rm -rf "$inst_dir"
        echo "Instance agy${inst_id} deleted successfully."
    else
        echo "Aborted."
    fi
}

# Main command dispatcher
case "$1" in
    -l|--list|list)
        list_instances
        ;;
    -u|--usage|-usage|usage)
        show_usage
        ;;
    -r|--run)
        shift
        if [ -z "$1" ]; then
            echo "Error: Instance number required. Example: agys -r 1" >&2
            exit 1
        fi
        inst_num="$1"
        shift
        run_instance "$inst_num" "$@"
        ;;
    -d|--delete)
        shift
        if [ -z "$1" ]; then
            echo "Error: Instance number required. Example: agys -d 1" >&2
            exit 1
        fi
        delete_instance "$1"
        ;;
    -h|--help|help)
        show_help
        ;;
    agy[0-9]*)
        cmd="$1"
        shift
        num="${cmd#agy}"
        run_instance "$num" "$@"
        ;;
    *)
        if [[ "$1" =~ ^[0-9]+$ ]]; then
            num="$1"
            shift
            run_instance "$num" "$@"
        else
            show_help
            exit 1
        fi
        ;;
esac
