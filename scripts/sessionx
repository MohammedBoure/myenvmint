#!/usr/bin/env bash
# ==============================================================================
# SessionX - Interactive Zellij Session Manager
# ==============================================================================
# Ergonomic fuzzy session switcher, creator, renamer, and terminator for Zellij.
# Integrates with fzf for instant search and provides quick single-key actions:
#   <Enter>   : Attach / Switch to session
#   Ctrl + r  : Rename selected session
#   Ctrl + x  : Kill selected session
#   Ctrl + n  : Create new session
# ==============================================================================

set -eo pipefail

CURRENT_SESSION="${ZELLIJ_SESSION_NAME:-}"

list_sessions() {
    local raw_sessions
    raw_sessions=$(zellij list-sessions -n 2>/dev/null || true)

    if [ -z "$raw_sessions" ]; then
        echo "(no running sessions)"
        return
    fi

    while IFS= read -r line; do
        [ -z "$line" ] && continue
        local sname
        sname=$(echo "$line" | awk '{print $1}')
        local details
        details=$(echo "$line" | cut -d' ' -f2-)

        if [ "$sname" = "$CURRENT_SESSION" ]; then
            printf "\033[1;32m%-24s\033[0m \033[1;33m[CURRENT]\033[0m %s\n" "$sname" "$details"
        else
            printf "\033[1;36m%-24s\033[0m \033[0;37m[ACTIVE]\033[0m  %s\n" "$sname" "$details"
        fi
    done <<< "$raw_sessions"
}

main_loop() {
    while true; do
        local sessions
        sessions=$(list_sessions)

        local header="SessionX [Zellij] | Enter: Attach/Switch | Ctrl+R: Rename | Ctrl+X: Kill | Ctrl+N: New | Esc: Exit"
        if [ -n "$CURRENT_SESSION" ]; then
            header="SessionX [Current: $CURRENT_SESSION] | Enter: Switch | Ctrl+R: Rename | Ctrl+X: Kill | Ctrl+N: New | Esc: Exit"
        fi

        local selected
        selected=$(echo "$sessions" | fzf --ansi \
            --header="$header" \
            --header-first \
            --prompt="SessionX > " \
            --expect=ctrl-r,ctrl-x,ctrl-d,ctrl-n \
            --no-mouse \
            --cycle \
            --reverse \
            --color="header:italic:cyan,prompt:bold:yellow,pointer:bold:green,hl:bold:yellow" || true)

        [ -z "$selected" ] && break

        local key
        key=$(echo "$selected" | head -n1)
        local line
        line=$(echo "$selected" | sed -n '2p')
        local target_session
        target_session=$(echo "$line" | awk '{print $1}')

        case "$key" in
            ctrl-r)
                if [ -n "$target_session" ] && [ "$target_session" != "(no" ]; then
                    printf "\nRename session '%s' to: " "$target_session"
                    read -r new_name
                    if [ -n "$new_name" ]; then
                        if [ "$target_session" = "$CURRENT_SESSION" ]; then
                            zellij action rename-session "$new_name" 2>/dev/null || true
                            CURRENT_SESSION="$new_name"
                        else
                            zellij action --session "$target_session" rename-session "$new_name" 2>/dev/null || true
                        fi
                    fi
                fi
                ;;
            ctrl-x|ctrl-d)
                if [ -n "$target_session" ] && [ "$target_session" != "(no" ]; then
                    printf "\nAre you sure you want to kill session '%s'? [y/N]: " "$target_session"
                    read -r confirm
                    if [[ "$confirm" =~ ^[Yy]$ ]]; then
                        zellij kill-session "$target_session" 2>/dev/null || true
                        if [ "$target_session" = "$CURRENT_SESSION" ]; then
                            exit 0
                        fi
                    fi
                fi
                ;;
            ctrl-n)
                printf "\nNew session name (leave blank for default): "
                read -r new_name
                if [ -n "$new_name" ]; then
                    if [ -n "$ZELLIJ" ]; then
                        zellij action switch-session "$new_name"
                    else
                        exec zellij -s "$new_name"
                    fi
                else
                    if [ -n "$ZELLIJ" ]; then
                        zellij action switch-session
                    else
                        exec zellij
                    fi
                fi
                break
                ;;
            "")
                # Default Enter was pressed
                if [ -n "$target_session" ] && [ "$target_session" != "(no" ]; then
                    if [ -n "$ZELLIJ" ]; then
                        zellij action switch-session "$target_session"
                    else
                        exec zellij attach "$target_session"
                    fi
                fi
                break
                ;;
        esac
    done
}

if command -v fzf >/dev/null 2>&1; then
    main_loop
else
    echo "Error: fzf is required for SessionX interactive mode." >&2
    exit 1
fi
