{
    "autoclose": true,
    "autoindent": true,
    "clipboard": "external",
    "colorscheme": "monokai",
    "cursorline": true,
    "fastdirty": true,
    "filemanager-openonstart": false,
    "hlsearch": true,
    "incsearch": true,
    "keepautoindent": true,
    "mouse": true,
    "openbftype": "tab",
    "rmtrailingws": true,
    "ruler": true,
    "saveundo": true,
    "scrollbar": true,
    "smartpaste": true,
    "softwrap": true,
    "statusformatl": "$(filename) $(modified)| $(line):$(col) | $(opt:filetype) | $(opt:encoding)",
    "tabsize": 4,
    "tabstospaces": true,
    "wordwrap": true,
    "linter": true,
    "autocomplete_tooltip.EnableCursorUpDown": true,
    "autofmt.onsave": true,
    "lsp.server": "python=pylsp,c=clangd,c++=clangd,rust=rust-analyzer",
    "lsp.tabcompletion": true,
    "lsp.autocompleteDetails": false,
    "lsp.formatOnSave": false
}
