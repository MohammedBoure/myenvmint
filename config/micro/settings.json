{
    "autoclose": true,
    "autoindent": false,
    "clipboard": "external",
    "colorscheme": "monokai",
    "cursorline": true,
    "fastdirty": true,
    "filemanager-openonstart": false,
    "hlsearch": true,
    "incsearch": true,
    "keepautoindent": false,
    "mouse": true,
    "openbftype": "tab",
    "rmtrailingws": true,
    "ruler": true,
    "saveundo": true,
    "scrollbar": true,
    "smartpaste": true,
    "softwrap": true,
    "statusformatl": "$(filename) $(modified)| $(line):$(col) | $(opt:filetype) | $(opt:encoding)",
    "tabsize": 4,
    "tabstospaces": true
}
