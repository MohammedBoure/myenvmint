# ==============================================================================
# Modern & Fast Zsh Configuration
# History-First Interactive Menu (PowerShell ListView UX) + Native Complist
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Path
# ------------------------------------------------------------------------------
export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"
export EDITOR="micro"
export VISUAL="micro"
export PATH="$HOME/.local/bin:$PATH"

# ------------------------------------------------------------------------------
# 2. History Settings
# ------------------------------------------------------------------------------
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000

setopt EXTENDED_HISTORY          # Write history in ':start:elapsed;command' format.
setopt SHARE_HISTORY             # Share history across all active terminals.
setopt HIST_EXPIRE_DUPS_FIRST    # Expire duplicate entries first when trimming history.
setopt HIST_IGNORE_DUPS          # Don't record duplicate consecutive entries.
setopt HIST_IGNORE_ALL_DUPS      # Delete old duplicate entry if new entry is a duplicate.
setopt HIST_FIND_NO_DUPS         # Do not display a line previously found.
setopt HIST_IGNORE_SPACE         # Don't record an entry starting with a space.
setopt HIST_SAVE_NO_DUPS         # Don't write duplicate entries in history file.
setopt HIST_REDUCE_BLANKS        # Remove superfluous blanks.
setopt HIST_VERIFY               # Don't execute immediately upon history expansion.

# ------------------------------------------------------------------------------
# 3. History-First Completion & Native Complist Interactive Menu
# ------------------------------------------------------------------------------
# Ensure complist is active
zmodload zsh/complist
autoload -Uz compinit && compinit -D

# Custom completer to pull exact history matching the current buffer prefix
_history_lines_first() {
  local -a matches
  matches=("${(@f)$(fc -l -n 1 2>/dev/null | sed -e 's/^[[:space:]]*//' | grep "^${words[1]}" | tail -n 20)}")
  matches=(${(u)matches:#})
  matches=("${matches[@]//:/\\:}")
  if [[ -n "$matches" ]]; then
    _describe -t history-lines 'History' matches
  fi
}

# Force Zsh to evaluate History BEFORE filenames and commands
zstyle ':completion:*' completer _history_lines_first _complete _approximate
zstyle ':completion:*' menu select=1
zstyle ':completion:*:history-lines' format '%F{yellow}[History]%f'
zstyle ':completion:*' group-name ''
zstyle ':completion:*' group-order history-lines
zstyle ':completion:*' list-grouped true
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*' verbose yes

# ------------------------------------------------------------------------------
# 4. Key Bindings (Interactive Menu Navigation & Emacs Mode)
# ------------------------------------------------------------------------------
bindkey -e # Use emacs keybindings mode

# Navigation keys for menu selection (PowerShell ListView style)
bindkey -M menuselect '^I' menu-complete                  # Tab cycles forward
bindkey -M menuselect '^[[Z' reverse-menu-complete         # Shift-Tab cycles backward
bindkey -M menuselect '^M' .accept-line                   # Enter executes selected command
bindkey -M menuselect '^[[A' up-line-or-history           # Up arrow moves up
bindkey -M menuselect '^[OA' up-line-or-history
bindkey -M menuselect '^[[B' down-line-or-history         # Down arrow moves down
bindkey -M menuselect '^[OB' down-line-or-history

# Make Tab instantly open and cycle menu-complete
bindkey '^I' menu-complete

# Arrow keys history substring search
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[OA' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search
bindkey '^[OB' down-line-or-beginning-search

# Standard word navigation
bindkey '^[[1;5C' forward-word
bindkey '^[[1;5D' backward-word
bindkey '^[[H' beginning-of-line
bindkey '^[[F' end-of-line
bindkey '^[[3~' delete-char

# ------------------------------------------------------------------------------
# 5. FZF Fuzzy History & Navigation Integration (Ctrl+R, Alt+C)
# ------------------------------------------------------------------------------
export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border'
export FZF_CTRL_R_OPTS='--preview "echo {}" --preview-window down:3:wrap --sort --exact'

if [ -f /usr/share/doc/fzf/examples/key-bindings.zsh ]; then
    source /usr/share/doc/fzf/examples/key-bindings.zsh
fi

# ------------------------------------------------------------------------------
# 6. Zsh Autosuggestions
# ------------------------------------------------------------------------------
if [ -f "$HOME/.zsh/zsh-autosuggestions/zsh-autosuggestions.zsh" ]; then
    source "$HOME/.zsh/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi

# ------------------------------------------------------------------------------
# 7. Syntax Highlighting (Must be loaded at the very end of plugins)
# ------------------------------------------------------------------------------
if [ -f "$HOME/.zsh/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]; then
    source "$HOME/.zsh/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi

# ------------------------------------------------------------------------------
# 8. Aliases
# ------------------------------------------------------------------------------
alias ls='ls --color=auto'
alias ll='ls -lah --color=auto'
alias la='ls -A --color=auto'
alias l='ls -CF --color=auto'
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'
alias df='df -h'
alias free='free -m'
alias start='start'
alias open='start'
alias explorer='start'

# ------------------------------------------------------------------------------
# 9. Starship Prompt Initialization
# ------------------------------------------------------------------------------
if command -v starship >/dev/null 2>&1; then
    eval "$(starship init zsh)"
fi

# ------------------------------------------------------------------------------
# 10. Zellij Auto-Completion
# ------------------------------------------------------------------------------
if command -v zellij >/dev/null 2>&1; then
    eval "$(zellij setup --generate-completion zsh)"
fi

# ------------------------------------------------------------------------------
# 11. Zellij Session Management & Workflow Optimization
# ------------------------------------------------------------------------------
if command -v zellij >/dev/null 2>&1; then
    # Quick attach to 'main' session (or create if not present)
    alias zj='zellij attach -c main'
    # List active sessions
    alias zls='zellij list-sessions'
    # Kill all sessions
    alias zka='zellij kill-all-sessions'

    # Quick attach wrapper: za [session_name] (defaults to 'main')
    za() {
        local session="${1:-main}"
        zellij attach -c "$session"
    }

    # Quick kill session: zk [session_name]
    zk() {
        if [ -n "$1" ]; then
            zellij kill-session "$1"
        else
            echo "Usage: zk <session-name>"
        fi
    }

    # Auto-attach to Zellij on interactive SSH login when ZELLIJ_AUTO_ATTACH=1
    # Enable by adding 'export ZELLIJ_AUTO_ATTACH=1' to ~/.zshenv or shell profile
    if [[ -n "$SSH_CONNECTION" || -n "$SSH_CLIENT" ]] && [[ -z "$ZELLIJ" && -t 0 && -t 1 && "${ZELLIJ_AUTO_ATTACH:-0}" == "1" ]]; then
        exec zellij attach -c main
    fi
fi


